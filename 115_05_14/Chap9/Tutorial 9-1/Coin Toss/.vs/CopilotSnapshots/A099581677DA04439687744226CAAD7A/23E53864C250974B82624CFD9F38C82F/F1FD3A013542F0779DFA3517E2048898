    class Coin
    {         private string sideUp;
        public Coin()
        {
           sideUp = "Heads";
        }
        public void Toss()
        {
            Random rand = new Random();
            int toss = rand.Next(2);
            if (toss == 0)
                sideUp = "Heads";
            else
                sideUp = "Tails";
        }
        public string GetSideUp()
        {
            return sideUp;
        }
    }
